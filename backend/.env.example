# --- LLM provider ----------------------------------------------------------
# API key for an OpenAI-compatible provider.
# Free option: get one at https://aistudio.google.com (no credit card needed).
GEMINI_API_KEY=

# Model name for the chosen provider. Must be free-tier eligible.
# Lite tier gets higher free-tier requests-per-minute and draws from a
# separate quota pool than the standard flash models.
# Gemini (free tier): LLM_MODEL=gemini-3.5-flash-lite
#   Higher quality fallback: LLM_MODEL=gemini-3.8-flash (same pool as the
#   daily request limit; swap in after the limit resets, midnight Pacific)
# Groq (free):        LLM_MODEL=llama-3.3-70b-versatile
# If you get HTTP 404, the model left the free tier - re-check /v1beta/openai/models
LLM_MODEL=gemini-3.5-flash-lite

# Optional: OpenAI-compatible base URL. Leave empty for OpenAI itself.
# No trailing slash on any of these.
# Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
# Groq:       https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
# Ollama:     http://localhost:11434/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional: upstream timeout in seconds (default 60).
LLM_TIMEOUT=60

# --- App -------------------------------------------------------------------
# Allowed frontend origin(s), comma-separated. Never use * here.
FRONTEND_ORIGIN=http://localhost:5173

# Development only: set to true to return clearly-labelled mock output
# without calling any model. Leave false for real rewrites.
MOCK_MODE=false